<!--
  Info.plist additions for Google Mobile Ads
  
  Merge these keys into the Info.plist generated by Cocos Creator's
  Build → iOS. The file is typically at:
    native/engine/ios/Info.plist
  or inside the .xcodeproj target settings.
-->

<!--
  1. Google Mobile Ads Application ID (test app ID)
     Replace with your production GAD App ID before release.
-->
<key>GADApplicationIdentifier</key>
<string>ca-app-pub-3940256099942544~1458002511</string>

<!--
  2. App Tracking Transparency usage description
     Required for iOS 14.5+ if you use personalized ads.
-->
<key>NSUserTrackingUsageDescription</key>
<string>This app would like to show you personalized ads based on your interests.</string>

<!--
  3. SKAdNetwork Items
     Required by Google Mobile Ads for attribution on iOS 14+.
     See: https://developers.google.com/admob/ios/quick-start#update_your_infoplist
-->
<key>SKAdNetworkItems</key>
<array>
  <!-- Google -->
  <dict>
    <key>SKAdNetworkIdentifier</key>
    <string>cstr6suwn9.skadnetwork</string>
  </dict>
  <!-- Additional SKAdNetwork IDs can be added from:
       https://developers.google.com/admob/ios/3p-skadnetworks
  -->
</array>
