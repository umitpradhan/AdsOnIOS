# Uncomment the next line to define a global platform for your project
platform :ios, '13.0'

# NOTE: Replace 'AdsOnIOS-mobile' with the actual Xcode target name
# generated by Cocos Creator's Build → iOS. Typically it matches
# your project name with a '-mobile' suffix.
target 'AdsOnIOS-mobile' do
  use_frameworks!

  # Google Mobile Ads SDK
  pod 'Google-Mobile-Ads-SDK'
end
